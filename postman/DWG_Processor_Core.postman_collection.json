		{
			"name": "Full Pipeline Test",
			"item": [
				{
					"name": "1. Get Forge Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"forge_token\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "client_id",
									"value": "{{forge_client_id}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{forge_client_secret}}",
									"type": "text"
								},
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "code:all data:read data:write",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "https://developer.api.autodesk.com/authentication/v2/token",
							"protocol": "https",
							"host": [
								"developer",
								"api",
								"autodesk",
								"com"
							],
							"path": [
								"authentication",
								"v2",
								"token"
							]
						},
						"description": "Получить Autodesk Forge Access Token"
					},
					"response": []
				},
				{
					"name": "2. List Activities",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{forge_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "https://developer.api.autodesk.com/da/us-east/v3/activities",
							"protocol": "https",
							"host": [
